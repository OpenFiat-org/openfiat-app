# Refuse to install on a Node older than `engines.node` says, instead of
# warning and carrying on.
#
# This repo needs Node 24 because jsdom 30 does. Without this line pnpm
# prints one WARN and installs anyway, so the first sign of the mismatch is
# a jsdom crash during `pnpm test` — a failure with nothing in it pointing
# at the Node version, several minutes after the moment that could have
# explained it.
#
# `engines.node` is the declaration; this is what makes the declaration
# mean something.
engine-strict=true

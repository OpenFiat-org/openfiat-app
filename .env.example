# Copy to `.env.local` and fill in what you need. `.env.local` is gitignored.
#
# Everything here is optional: the app runs with none of it set, against the
# public devnet node, with uploads disabled. Each variable below turns
# something on rather than being required to start.
#
# ---------------------------------------------------------------------------
# The NEXT_PUBLIC_ prefix is not decoration
# ---------------------------------------------------------------------------
# Next inlines a NEXT_PUBLIC_* value into the JavaScript bundle at BUILD time.
# It is readable by every visitor of every page, forever, in any browser's
# devtools. It is therefore only ever correct for values that are already
# public — a node URL, a gateway.
#
# Never give a credential that prefix. The pinning variables below deliberately
# do not have it, and `lib/ipfs/providers.ts` imports `server-only` so that
# reaching them from a client component is a build error rather than a silent
# leak.


# ---------------------------------------------------------------------------
# Uploading avatars and dispute evidence
# ---------------------------------------------------------------------------
# Without one of these, `POST /api/ipfs/upload` answers 503 and the interface
# says "This deployment has no IPFS provider configured, so uploads are
# unavailable." That is deliberate: a deployment with no pinning configured
# should say so rather than quietly push a user's file to a service nobody
# chose and nobody will keep paying to pin.
#
# Note this is about STORING new bytes. Reading and serving content needs
# nothing here — an OpenFiat node holds and serves blocks itself over bitswap.
# What a node cannot yet do is accept an upload, which is why this reaches
# outside at all.
#
# Pick ONE.

# 1. Pinata. Create a JWT with the pinFileToIPFS scope.
#PINATA_JWT=

# 2. Any Kubo-compatible RPC — Filebase's rpc.filebase.io, your own
#    `ipfs daemon`, or another provider speaking the same API. CIDv1 is
#    requested explicitly, because this protocol refuses a v0 `Qm…` identifier.
#IPFS_RPC_URL=http://127.0.0.1:5001
#IPFS_RPC_TOKEN=

# Force a choice when both are present. Omit to auto-detect: Pinata if
# PINATA_JWT is set, otherwise the Kubo endpoint.
#IPFS_PROVIDER=pinata


# ---------------------------------------------------------------------------
# Which node the app talks to
# ---------------------------------------------------------------------------
# Defaults to the public devnet node. Point at your own to see your own state.
#NEXT_PUBLIC_OPENFIAT_NODE_URL=http://127.0.0.1:7080

# The node picker's list, comma-separated. The user chooses among these.
#NEXT_PUBLIC_OPENFIAT_NODES=http://127.0.0.1:7080,http://127.0.0.1:7081

# Server-side only, for scripts and route handlers that are not user-selected.
#OPENFIAT_NODE_URL=http://127.0.0.1:7080


# ---------------------------------------------------------------------------
# Chain and gateways
# ---------------------------------------------------------------------------
# Solana devnet RPC. The default public endpoint is heavily rate-limited; a
# dedicated one is worth having if you are doing anything repeatedly.
#
# This IS public — it ships in the browser bundle. Use an endpoint you are
# willing to have called by anyone who loads the page, and never one whose
# URL embeds a secret API key.
#NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Where the browser reads IPFS content from.
#NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.filebase.io

# The devnet faucet.
#NEXT_PUBLIC_FAUCET_URL=
